@model Department

<h2>Add Department</h2>

<form method="post">

    <div>
        <label>Name</label>
        <input type="text" name="Name" class="form-control" />
    </div>

    <div>
        <label>Manager Name</label>
        <input type="text" name="MgrName" class="form-control" />
    </div>

    <br />

    <button type="submit" class="btn btn-success">Save</button>
</form>

<a href="/Department/ShowAll">Back</a>