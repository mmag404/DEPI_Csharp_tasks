@model day02.ViewModels.CourseVM

<h2>Create Course</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Degree</label>
        <input asp-for="Degree" class="form-control" />
        <span asp-validation-for="Degree" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Min Degree</label>
        <input asp-for="MinDegree" class="form-control" />
        <span asp-validation-for="MinDegree" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Department</label>
        <select asp-for="DepartmentId"
                asp-items="Model.Departments"
                class="form-control">
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <button class="btn btn-success">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}