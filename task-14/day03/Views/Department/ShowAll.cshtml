@model List<Department>

<h2>All Departments</h2>

<a href="/Department/Add" class="btn btn-primary">New</a>

<table class="table">
    <tr>
        <th>Name</th>
        <th>Details</th>
    </tr>

    @foreach (var dept in Model)
    {
        <tr>
            <td>@dept.Name</td>
            <td>
                <a href="/Department/ShowDetails/@dept.Id">View</a>
            </td>
        </tr>
    }
</table>