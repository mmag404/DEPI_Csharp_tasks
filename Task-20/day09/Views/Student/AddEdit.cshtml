@using day02.ViewModels
@model StudentFormVM

<h2>@(Model.Id == 0 ? "Add Student" : "Edit Student")</h2>

<form asp-action="@(Model.Id == 0 ? "Add" : "Edit")"
      asp-controller="Student"
      method="post">
    <partial name="_FormPartial" model="Model" />
    <button type="submit" class="btn btn-success">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
